{
  "name": "PatientMapping",
  "version": 1,
  "target_resource": "Patient",
  "status": "approved",
  "constants": {
    "identifier[0].system": "http://hospital.smarthealth.org/memid",
    "identifier[0].type.text": "Member ID",
    "identifier[1].system": "http://hospital.smarthealth.org/entityid",
    "identifier[1].type.text": "Entity ID",
    "identifier[2].system": "http://hl7.org/fhir/sid/us-ssn",
    "identifier[2].type.text": "SSN",
    "identifier[3].system": "http://hospital.smarthealth.org/umin",
