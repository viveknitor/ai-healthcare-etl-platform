      "args": {
        "Active": true,
        "A": true,
        "Inactive": false,
        "I": false,
        "default": true
      },
      "required": false,
      "confidence": 0.9,
      "rationale": "Maps patient status to active boolean"
    },
    {
      "source": "sex",
      "target": "gender",
      "transform": "map",
      "args": {
        "M": "male",
        "F": "female",
        "default": "unknown"
      },
      "required": false,
      "confidence": 1.0,
      "rationale": "Maps sex code to FHIR administrative gender"
    },
    {
      "source": "fullname",
      "target": "name[0].text",
