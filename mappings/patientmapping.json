    "identifier[4].system": "http://hospital.smarthealth.org/secondaryid",
    "identifier[4].type.text": "Secondary ID",
    "identifier[5].system": "http://hospital.smarthealth.org/enterpriseid",
    "identifier[5].type.text": "Enterprise ID",
    "identifier[6].system": "http://hospital.smarthealth.org/ExternalId",
    "identifier[6].type.text": "External ID"
  },
  "rules": [
    {
      "source": "memid",
      "target": "identifier[0].value",
      "transform": "direct",
      "args": {},
      "required": true,
      "confidence": 1.0,
      "rationale": "Maps member ID to primary patient identifier"
    },
    {
      "source": "entityid",
      "target": "identifier[1].value",
      "transform": "direct",
      "args": {},
      "required": false,
      "confidence": 0.9,
      "rationale": "Maps entity ID to secondary patient identifier"
    },
    {
      "source": "ssn",
      "target": "identifier[2].value",
      "transform": "direct",
      "args": {},
      "required": false,
      "confidence": 1.0,
      "rationale": "Maps social security number to patient identifier"
    },
    {
      "source": "umin",
      "target": "identifier[3].value",
      "transform": "direct",
      "args": {},
      "required": false,
      "confidence": 0.9,
      "rationale": "Maps UMIN to patient identifier"
    },
    {
      "source": "secondaryid",
      "target": "identifier[4].value",
